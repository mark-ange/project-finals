{
  "name": "civicalert-platform",
  "private": true,
  "workspaces": [
    "frontend/apps/*",
    "frontend/packages/*"
  ],
  "scripts": {
    "dev:all": "concurrently -n resident,cepalco,water -c green,red,blue \"npm:dev:resident\" \"npm:dev:cepalco\" \"npm:dev:water\"",
    "dev:resident": "npm run dev --workspace @civicalert/resident-web",
    "dev:cepalco": "npm run dev --workspace @civicalert/cepalco-web",
    "dev:water": "npm run dev --workspace @civicalert/water-web",
    "build": "npm run build --workspace @civicalert/resident-web && npm run build --workspace @civicalert/cepalco-web && npm run build --workspace @civicalert/water-web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@tailwindcss/vite": "^4.0.6",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.6",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.3"
  }
}
